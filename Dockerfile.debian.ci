# Dockerfile.debian.ci — CI/release Debian image using pre-built binaries.
# Mirrors the Debian runtime toolchain from Dockerfile.debian while reusing
# pre-built binaries so release workflows skip expensive QEMU cross-compilation.

# ── Runtime (Debian with shell + modern Python/Node) ───────────
FROM node:24-bookworm-slim

ARG TARGETARCH

# Install essential tools for agent shell operations and modern scripting
# toolchains. `node:24-bookworm-slim` provides current Node LTS, npm, and
# Corepack; apt installs the Python runtime plus native build prerequisites
# commonly needed by pip/node-gyp packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        git \
        pipx \
        pkg-config \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Enable package-manager shims for pnpm/yarn and install uv as a standalone
# Python tool manager without coupling it to the system site-packages.
RUN corepack enable && \
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Copy the pre-built binary for this platform (amd64 or arm64)
COPY bin/${TARGETARCH}/zeroclaw /usr/local/bin/zeroclaw

# Runtime directory structure and default config
COPY --chown=65534:65534 zeroclaw-data/ /zeroclaw-data/

ENV LANG=C.UTF-8
ENV ZEROCLAW_WORKSPACE=/zeroclaw-data/workspace
ENV HOME=/zeroclaw-data
ENV PATH=/zeroclaw-data/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
ENV ZEROCLAW_GATEWAY_PORT=42617

WORKDIR /zeroclaw-data
USER 65534:65534
EXPOSE 42617
HEALTHCHECK --interval=60s --timeout=10s --retries=3 --start-period=10s \
    CMD ["zeroclaw", "status", "--format=exit-code"]
ENTRYPOINT ["zeroclaw"]
CMD ["daemon"]
